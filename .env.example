# Copy to .env and fill in. Never commit .env.

# REQUIRED. At least 32 random characters:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# production = strict start-up checks, API docs hidden, HSTS header on.
# Use "development" locally if you want http://localhost:8000/docs.
ENVIRONMENT=production
# ENABLE_DOCS=false
# ENABLE_HSTS=false              # only when the site is served over HTTPS

# Optional: without a key the deterministic planner is used (answers still verified).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# false = never send aggregated results (group labels + values) to the LLM; only the column
# names reach the planner and the narrator is the built-in template.
LLM_SHARE_RESULTS=true

CORS_ORIGINS=http://localhost:5173
ALLOW_REGISTRATION=true          # set false once your users have signed up

# Upload and request limits
MAX_UPLOAD_MB=100
MAX_ROWS=2000000
MAX_COLUMNS=500
MAX_UNZIPPED_MB=500              # .xlsx zip-bomb guard
MAX_DATASETS_PER_ORG=50
MAX_JSON_BODY_BYTES=262144

# Rate limits (per minute)
ASK_RATE_LIMIT_PER_MIN=20
LOGIN_RATE_LIMIT_PER_MIN=10      # applied per IP and per account
HEAVY_RATE_LIMIT_PER_MIN=30      # uploads, auto dashboards, exports

# DATABASE_URL=postgresql+psycopg://user:pass@host/db   (SQLite inside DATA_DIR by default)
